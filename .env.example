# Copy to .env and fill in. Everything has safe defaults for local development.

# --- Secrets (REQUIRED in production) ---
# SECRET_KEY must be 32+ random characters in production (the app refuses known dev values).
SECRET_KEY=generate-a-long-random-string
# Letters and digits only (it is embedded in a database URL). Note: changing it
# after first boot does NOT update an existing database volume; run
# `docker compose down -v` to reset (deletes all data).
POSTGRES_PASSWORD=pick-a-db-password

# --- Gemini (leave empty to run in mock mode: full app works with fake stories/images) ---
GOOGLE_API_KEY=
# auto = gemini when key present, otherwise mock. Or force: gemini | mock
GENERATION_PROVIDER=auto

# --- Tuning (optional) ---
ENVIRONMENT=development
API_PORT=8000
FREE_DAILY_STORIES=3

# Peer IPs whose X-Forwarded-For header is believed, comma separated. Empty
# means trust none, which is correct when clients reach the API directly.
# IMPORTANT: if you put a reverse proxy, load balancer, or CDN in front, set
# this to that proxy's IP. Otherwise every request appears to come from the
# proxy and the auth rate limiter throttles all your users as if they were one.
TRUSTED_PROXY_IPS=
# Hard ceiling on any request body, in bytes. Requests above it get a 413
# before the body is buffered.
MAX_REQUEST_BODY_BYTES=65536
