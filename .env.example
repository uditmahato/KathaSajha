# Copy to .env and fill in. Everything has safe defaults for local development.

# --- Secrets (REQUIRED in production) ---
# SECRET_KEY must be 32+ random characters in production (the app refuses known dev values).
SECRET_KEY=generate-a-long-random-string
# Letters and digits only (it is embedded in a database URL). Note: changing it
# after first boot does NOT update an existing database volume; run
# `docker compose down -v` to reset (deletes all data).
POSTGRES_PASSWORD=pick-a-db-password

# --- Gemini (leave empty to run in mock mode: full app works with fake stories/images) ---
GOOGLE_API_KEY=
# auto = gemini when key present, otherwise mock. Or force: gemini | mock
GENERATION_PROVIDER=auto

# --- Tuning (optional) ---
ENVIRONMENT=development
API_PORT=8000
FREE_DAILY_STORIES=3
# The daily cap smooths bursts; this is the real allowance and what bounds cost.
FREE_MONTHLY_STORIES=10

# --- Unit cost telemetry (USD, from the provider pricing page) ---
# Left at 0 = unset. Token and image counts are recorded regardless, so cost
# can be recomputed for past generations once these are filled in.
PRICE_PER_1M_INPUT_TOKENS_USD=0
PRICE_PER_1M_OUTPUT_TOKENS_USD=0
PRICE_PER_IMAGE_USD=0

# Peer IPs whose X-Forwarded-For header is believed, comma separated. Empty
# means trust none, which is correct when clients reach the API directly.
# IMPORTANT: if you put a reverse proxy, load balancer, or CDN in front, set
# this to that proxy's IP. Otherwise every request appears to come from the
# proxy and the auth rate limiter throttles all your users as if they were one.
TRUSTED_PROXY_IPS=
# Hard ceiling on any request body, in bytes. Requests above it get a 413
# before the body is buffered.
MAX_REQUEST_BODY_BYTES=65536
# Extra font directories for PDF export, comma separated. Normally unneeded:
# the Docker image installs Noto and a Windows dev box uses its system fonts.
PDF_FONT_DIRS=

# --- Billing (dormant until ALL THREE are set) ---
# Leave empty and the app behaves exactly as it does today: billing routes do
# not exist and Plus is not purchasable. Setting only some of these is refused
# at startup rather than half-enabled -- a secret key without a webhook secret
# takes a customer's money and never upgrades them.
# Going live is these three values plus a restart; no code change.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# plan code = Stripe price id (must start with price_, not prod_)
STRIPE_PRICE_IDS=
# Required once billing is live: Stripe return URLs must be absolute and stable.
PUBLIC_BASE_URL=
